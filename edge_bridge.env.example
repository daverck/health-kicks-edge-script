# Copy to /etc/smartstride-edge/edge_bridge.env on the Raspberry Pi.
# Keep this file outside Git when it contains credentials.
EDGE_SERIAL_DEVICE=/dev/ttyUSB0
EDGE_SERIAL_BAUDRATE=115200
EDGE_MQTT_HOST=localhost
EDGE_MQTT_PORT=1883
EDGE_MQTT_CLIENT_ID=smartstride-edge
EDGE_MQTT_USERNAME=
EDGE_MQTT_PASSWORD=
EDGE_TELEMETRY_TOPIC=healthkicks/telemetry/raw
EDGE_COMMAND_TOPIC=healthkicks/commands/haptic
EDGE_LOG_LEVEL=INFO