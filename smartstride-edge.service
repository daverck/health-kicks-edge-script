[Unit]
Description=SmartStride serial to MQTT edge bridge
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=dialout
WorkingDirectory=/opt/smartstride-edge
EnvironmentFile=-/etc/smartstride-edge/edge_bridge.env
ExecStart=/opt/smartstride-edge/.venv/bin/python /opt/smartstride-edge/edge_bridge.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target