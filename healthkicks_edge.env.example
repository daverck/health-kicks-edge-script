# Copy to /etc/healthkicks_edge/healthkicks_edge.env on the Raspberry Pi.
# Keep this file outside Git when it contains credentials.
EDGE_DEVICE_ID=healthkicks-pi-001
EDGE_SERIAL_DEVICE=/dev/ttyUSB0
EDGE_SERIAL_BAUDRATE=115200
EDGE_MQTT_HOST=localhost
EDGE_MQTT_PORT=1883
EDGE_MQTT_CLIENT_ID=healthkicks-pi-001-edge
EDGE_MQTT_USERNAME=
EDGE_MQTT_PASSWORD=
EDGE_TELEMETRY_TOPIC=healthkicks/v1/healthkicks-pi-001/telemetry/raw
EDGE_FALL_TOPIC=healthkicks/v1/healthkicks-pi-001/events/fall
EDGE_COMMAND_TOPIC=healthkicks/v1/healthkicks-pi-001/commands/haptic
EDGE_STATUS_TOPIC=healthkicks/v1/healthkicks-pi-001/status
EDGE_HEARTBEAT_INTERVAL=30
EDGE_COMMAND_TTL=2
EDGE_FALL_COOLDOWN=3
EDGE_MODEL_PATH=/var/lib/healthkicks/model.joblib
EDGE_MODEL_WINDOW_SIZE=32
EDGE_LOG_LEVEL=INFO