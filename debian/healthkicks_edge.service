[Unit]
Description=HealthKicks edge agent
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=healthkicks_edge
Group=dialout
SupplementaryGroups=dialout
WorkingDirectory=/opt/healthkicks_edge
EnvironmentFile=-/etc/healthkicks_edge/agent.env
ExecStart=/usr/bin/python3 /opt/healthkicks_edge/main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
StateDirectory=healthkicks

[Install]
WantedBy=multi-user.target
