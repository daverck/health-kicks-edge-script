[Unit]
Description=HealthKicks edge agent
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=healthkicks_edge
Group=dialout
SupplementaryGroups=dialout
WorkingDirectory=/opt/healthkicks_edge
EnvironmentFile=-/etc/healthkicks_edge/healthkicks_edge.env
ExecStart=/usr/bin/python3 -m healthkicks_edge
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1 PYTHONPATH=/opt/healthkicks_edge
StateDirectory=healthkicks

[Install]
WantedBy=multi-user.target
