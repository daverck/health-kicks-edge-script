EDGE_DEVICE_ID=HK-1
EDGE_SERIAL_DEVICE=/dev/ttyUSB0
EDGE_SERIAL_BAUDRATE=115200
EDGE_MQTT_HOST=localhost
EDGE_MQTT_PORT=1883
EDGE_MQTT_CLIENT_ID=HK-1-edge
EDGE_MQTT_USERNAME=
EDGE_MQTT_PASSWORD=
EDGE_TELEMETRY_TOPIC=healthkicks/v1/HK-1/telemetry/raw
EDGE_FALL_TOPIC=healthkicks/v1/HK-1/events/fall
EDGE_COMMAND_TOPIC=healthkicks/v1/HK-1/commands/haptic
EDGE_STUDIO_COMMAND_TOPIC=healthkicks/v1/HK-1/commands/studio/start
EDGE_STATUS_TOPIC=healthkicks/v1/HK-1/status
EDGE_ACK_TOPIC=healthkicks/v1/HK-1/commands/ack
EDGE_HEARTBEAT_INTERVAL=30
EDGE_COMMAND_TTL=2
EDGE_FALL_COOLDOWN=3
EDGE_MODEL_PATH=/opt/healthkicks_edge/models/activity_classifier.joblib
EDGE_MODEL_WINDOW_SIZE=32
EDGE_LOG_LEVEL=INFO
EDGE_BUFFER_MAX_SIZE=50
EDGE_BUFFER_FLUSH_INTERVAL_SEC=2.0
EDGE_CONTINUOUSLY_SEND_TELEMETRY=false
EDGE_DETECTION_TOPIC=healthkicks/v1/HK-1/events/detection
EDGE_INFERENCE_INTERVAL_SEC=0.25
EDGE_CONFIDENCE_THRESHOLD=0.65
EDGE_DETECTION_COOLDOWN_SEC=5.0
EDGE_MIN_FALL_IMPACT_THRESHOLD=18.0
